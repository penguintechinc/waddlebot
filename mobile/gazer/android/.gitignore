# gradlew, gradlew.bat and gradle/wrapper/gradle-wrapper.jar are deliberately COMMITTED here (the
# container toolchain runs ./gradlew and the wrapper is pinned by distributionSha256Sum), so the
# Flutter template's ignores for them are removed rather than force-added around.
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
